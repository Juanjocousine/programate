{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://programate.local/schemas/progress-event.schema.json",
  "title": "Evento de respuesta",
  "description": "Misma forma que el registro de Mi Chuleta DAM 2.0. El estado de repaso se calcula desde estos eventos; no se guarda aparte.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture", "t", "id", "r", "m", "sc"],
  "properties": {
    "fixture": { "const": true },
    "t": { "type": "integer", "minimum": 1, "maximum": 4102444800000 },
    "id": { "type": "string", "minLength": 1, "maxLength": 40 },
    "r": { "enum": ["o", "k", "b"] },
    "m": { "enum": ["apr", "err", "due", "cod", "sim"] },
    "sc": { "type": "number", "minimum": -1, "maximum": 1 },
    "s": { "type": "string", "minLength": 1, "maxLength": 12 },
    "c": { "type": "string", "minLength": 1, "maxLength": 40 },
    "sf": { "const": 1 }
  }
}
