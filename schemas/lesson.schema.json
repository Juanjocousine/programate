{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://programate.local/schemas/lesson.schema.json",
  "title": "Lección",
  "description": "Secuencia didáctica. En esta versión solo puede citar términos y preguntas ya existentes. No admite un bloque de prosa libre.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "conceptIds", "routeIds", "blocks", "sample", "provenance", "revision"],
  "properties": {
    "id": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "conceptIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/id" }
    },
    "routeIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/id" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/id" },
          "type": { "enum": ["term", "item"] },
          "termId": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/id" },
          "itemId": { "type": "string", "minLength": 1, "maxLength": 40 },
          "role": { "enum": ["explain", "check"] }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "term" } },
              "required": ["type"]
            },
            "then": {
              "required": ["termId", "role"],
              "properties": { "role": { "const": "explain" } },
              "not": { "required": ["itemId"] }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "item" } },
              "required": ["type"]
            },
            "then": {
              "required": ["itemId", "role"],
              "properties": { "role": { "const": "check" } },
              "not": { "required": ["termId"] }
            }
          }
        ]
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "includedItemIds", "knownSourceItemIds", "note"],
      "properties": {
        "coverage": { "enum": ["partial", "complete"] },
        "includedItemIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "knownSourceItemIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "provenance": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/provenance" },
    "revision": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/revision" }
  }
}
