{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://programate.local/schemas/route.schema.json",
  "title": "Itinerario",
  "description": "Orden de lecciones para un perfil. No copia el banco: apunta a lecciones, que apuntan a conceptos compartidos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "audience", "status", "sourceStatement", "steps", "provenance", "revision"],
  "properties": {
    "id": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "audience": { "enum": ["fp", "professional"] },
    "program": { "enum": ["DAM", "DAW", "SMR", "ASIR"] },
    "moduleCode": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/id" },
    "sourceTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sourceStatement": { "type": "string", "minLength": 1, "maxLength": 500 },
    "status": { "enum": ["sample", "partial", "ready"] },
    "coverageNote": { "type": "string", "minLength": 1, "maxLength": 500 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lessonId"],
        "properties": {
          "lessonId": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/id" }
        }
      }
    },
    "provenance": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/provenance" },
    "revision": { "$ref": "https://programate.local/schemas/defs.schema.json#/$defs/revision" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "audience": { "const": "fp" } },
        "required": ["audience"]
      },
      "then": { "required": ["program", "moduleCode"] }
    }
  ]
}
